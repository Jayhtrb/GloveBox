<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gb_background">

    <!-- The GloveBox home screen: the bundled web UI that matches the design. -->
    <WebView
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Native browser, shown on top of the dashboard when the user browses. -->
    <LinearLayout
        android:id="@+id/browseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/gb_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@color/gb_surface">

            <Button
                android:id="@+id/btnBrowseBack"
                style="@style/GbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←" />

            <Button
                android:id="@+id/btnBrowseForward"
                style="@style/GbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→" />

            <Button
                android:id="@+id/btnBrowseReload"
                style="@style/GbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⟳" />

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/url_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/gb_text"
                android:textColorHint="@color/gb_text_dim" />

            <Button
                android:id="@+id/btnBrowseHome"
                style="@style/GbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂" />

            <Button
                android:id="@+id/btnCloseBrowse"
                style="@style/GbButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_close_browse" />
        </LinearLayout>

        <WebView
            android:id="@+id/browse"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Fullscreen video (YouTube's fullscreen button and similar). Covers everything else. -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
